# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Python / Bytecode / Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / Empacotamento
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testes / Cobertura / Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Dados gerados, checkpoints e temporários do pipeline
data/checkpoints/*
!data/checkpoints/.gitkeep
data/output/*
!data/output/.gitkeep
data/tmp/*
!data/tmp/.gitkeep

# Arquivos brutos e binários de dados eleitorais / logs
*.parquet
*.logjez
*.dat

# Logs de execução
*.log

# Variáveis de ambiente e segredos locais
.env
.env.*
!.env.example

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db
